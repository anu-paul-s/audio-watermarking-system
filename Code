}

function sampledPoints(samples, count = 500) {
  if (!samples || !samples.length) return [];
  const stride = Math.max(1, Math.floor(samples.length / count));
  const points = [];

  for (let i = 0; i < samples.length; i += stride) {
    points.push({ x: i, y: samples[i] });
  }
  return points;
}

function spectrumPoints(samples, sampleRate, count = 300) {
  if (!samples || samples.length < 16) return [];

  const n = Math.min(4096, nextPowerOfTwo(Math.min(samples.length, 4096)));
  const frame = new Float64Array(n);
  for (let i = 0; i < n; i++) frame[i] = samples[i] || 0;

  const result = fft(frame);
  const half = Math.floor(n / 2);
  let maxMag = 0;

  for (let i = 0; i < half; i++) {
    maxMag = Math.max(maxMag, Math.hypot(result.re[i], result.im[i]));
  }

  const points = [];
  const stride = Math.max(1, Math.floor(half / count));

  for (let i = 1; i < half; i += stride) {
    points.push({
      x: Math.round(i * sampleRate / n),
      y: maxMag ? Math.hypot(result.re[i], result.im[i]) / maxMag : 0
    });
  }

  return points;
}

