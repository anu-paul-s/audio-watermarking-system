<script>
"use strict";

/* -------------------------------------------------------
   State
------------------------------------------------------- */

const state = {
  audioContext: null,
  sourceBuffer: null,
  original: null,
  embedded: null,
  processed: null,
  sampleRate: 44100,
  processedSampleRate: 44100,
  fileName: "",
  messageBits: [],
  lastRecoveredBits: [],
  history: [],
  charts: {},
  originalBlobUrl: null,
  busy: false,
  players: {
  original: {
    source: null,
    buffer: null,
    samples: null,
    offset: 0,
    startedAt: 0
  },
  processed: {
    source: null,
    buffer: null,
    samples: null,
    offset: 0,
    startedAt: 0
  }
},
};

const $ = id => document.getElementById(id);

function getAudioContext() {
  if (!state.audioContext) {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) throw new Error("Web Audio API is not supported in this browser.");
    state.audioContext = new AudioCtx();
  }
  return state.audioContext;
}

function log(message, type = "info") {
  const host = $("log");
  const line = document.createElement("div");
  line.className = "log-line";

  const time = new Date().toLocaleTimeString([], {
    hour: "2-digit", minute: "2-digit", second: "2-digit"
  });

  const timeSpan = document.createElement("span");
  timeSpan.className = "log-time";
  timeSpan.textContent = "[" + time + "] ";

  const messageSpan = document.createElement("span");
  messageSpan.className =
    type === "ok" ? "log-ok" :
    type === "warn" ? "log-warn" :
    type === "error" ? "log-error" : "";
  messageSpan.textContent = message;

  line.append(timeSpan, messageSpan);
  host.appendChild(line);
  host.scrollTop = host.scrollHeight;
}

function setProgress(percent, text) {
  $("progressFill").style.width = Math.max(0, Math.min(100, percent)) + "%";
  $("progressText").textContent = text;
}

function setBusy(busy) {
  state.busy = busy;
  [
    "embedBtn", "extractBtn", "applyAttackBtn", "restoreBtn",
    "resetBtn", "demoBtn", "chooseFileBtn"
  ].forEach(id => $(id).disabled = busy);

  updateButtons();
}

function updateButtons() {
  $("embedBtn").disabled = state.busy || !state.original;
  $("extractBtn").disabled = state.busy || !state.embedded;
  $("applyAttackBtn").disabled = state.busy || !state.embedded;
  $("restoreBtn").disabled = state.busy || !state.embedded;
  $("playOriginalBtn").disabled = !state.original;
  $("playOutputBtn").disabled = !state.processed;
  $("downloadBtn").disabled = !state.processed;
  updatePlaybackButtons();
}

/* -------------------------------------------------------
   Audio file loading and playback
------------------------------------------------------- */

function stopPlayer(kind, resetPosition = true) {
  const player = state.players[kind];
  if (!player) return;

  if (player.source) {
    const source = player.source;
    player.source = null;
    source.onended = null;
    try { source.stop(); } catch (_) { /* Source may already have stopped. */ }
  }

  if (resetPosition) player.offset = 0;
  if (resetPosition) {
    player.buffer = null;
    player.samples = null;
  }
}

function stopAllPlayers() {
  stopPlayer("original");
  stopPlayer("processed");
  updatePlaybackButtons();
}

function updatePlaybackButtons() {
  $("pauseOriginalBtn").disabled = !state.players.original.source;
  $("pauseOutputBtn").disabled = !state.players.processed.source;
}

async function decodeAudioFile(file) {
  if (!file) return;
  stopAllPlayers();

  try {
    setBusy(true);
    setProgress(10, "Reading audio file...");
    log("Loading audio file: " + file.name);

    const ctx = getAudioContext();
    const bytes = await file.arrayBuffer();
    const decoded = await ctx.decodeAudioData(bytes.slice(0));

    const channel = decoded.getChannelData(0);
    state.original = new Float32Array(channel);
    state.sourceBuffer = decoded;
    state.sampleRate = decoded.sampleRate;
    state.processedSampleRate = decoded.sampleRate;
    state.fileName = file.name;
    state.embedded = null;
    state.processed = null;
    state.messageBits = [];
    state.lastRecoveredBits = [];
    state.history = [];

    $("fileName").textContent = file.name;
    $("audioInfo").textContent =
      decoded.sampleRate.toLocaleString() + " Hz · " +
      decoded.numberOfChannels + " channel(s)";
    $("durationInfo").textContent =
      "Duration: " + decoded.duration.toFixed(2) + " s";

    clearResults();
    drawWaveCanvas($("inputWave"), state.original);
    drawWaveCanvas($("outputWave"), null);
    refreshCharts();
    resetBerChart();
    updateButtons();
    setProgress(100, "Audio loaded successfully.");

    log(
      "Decoded " + state.original.length.toLocaleString() +
      " samples at " + state.sampleRate + " Hz.",
      "ok"
    );
  } catch (err) {
    log("Could not decode audio: " + err.message, "error");
    setProgress(0, "Audio could not be decoded. Try a WAV file.");
    alert("Unable to decode this audio file. Try a WAV file or a different browser.");
  } finally {
    setBusy(false);
  }
}


function playSamples(samples, sampleRate, kind) {
  if (!samples || !samples.length) return;

  try {
    const ctx = getAudioContext();
    const player = state.players[kind];

    // Keep the comparison clear: do not play original and processed audio over each other.
    stopPlayer(kind === "original" ? "processed" : "original");
    if (ctx.state === "suspended") ctx.resume();

    // Create a new buffer if the audio has changed
    if (player.samples !== samples || !player.buffer) {
      if (player.source) {
        player.source.onended = null;
        player.source.stop();
      }

      player.samples = samples;
      player.buffer = ctx.createBuffer(1, samples.length, sampleRate);
      player.buffer.copyToChannel(Float32Array.from(samples), 0);
      player.offset = 0;
      player.source = null;
    }

    // Do not start a second copy while this one is playing
    if (player.source) return;

    if (player.offset >= player.buffer.duration) {
      player.offset = 0;
    }

    const source = ctx.createBufferSource();
    source.buffer = player.buffer;
    source.connect(ctx.destination);

    player.source = source;
    player.startedAt = ctx.currentTime;

    source.onended = () => {
      if (player.source !== source) return;
      player.source = null;
      player.offset = 0;
      updatePlaybackButtons();
    };

    source.start(0, player.offset);
    updatePlaybackButtons();

  } catch (err) {
    log("Playback error: " + err.message, "error");
  }
}

function pauseSamples(kind) {
  const player = state.players[kind];

  if (!player || !player.source) return;

  player.offset += state.audioContext.currentTime - player.startedAt;

  const source = player.source;
  player.source = null;
  source.onended = null;
  source.stop();
  updatePlaybackButtons();
}

/* -------------------------------------------------------
   Demo audio: synthetic multitone signal with an envelope
------------------------------------------------------- */

function makeDemoAudio() {
  stopAllPlayers();
  const sampleRate = 44100;
  const duration = 8;
  const length = sampleRate * duration;
  const samples = new Float32Array(length);

  for (let i = 0; i < length; i++) {
    const t = i / sampleRate;

    const envelope =
      0.45 +
      0.25 * Math.sin(2 * Math.PI * 0.22 * t) ** 2;

    const tone =
      0.48 * Math.sin(2 * Math.PI * 220 * t) +
      0.24 * Math.sin(2 * Math.PI * 440 * t) +
      0.15 * Math.sin(2 * Math.PI * 660 * t) +
      0.08 * Math.sin(2 * Math.PI * 1100 * t);

   const transient =
  0.12 * Math.sin(2 * Math.PI * 1600 * t) *
  Math.exp(-Math.pow((t % 0.75) - 0.08, 2) / 0.001);

    samples[i] = (tone + transient) * envelope;
  }

  state.original = samples;
  state.sampleRate = sampleRate;
  state.processedSampleRate = sampleRate;
  state.fileName = "wavelab-demo.wav";
  state.sourceBuffer = null;
  state.embedded = null;
  state.processed = null;
  state.processedSampleRate = state.sampleRate;
  state.messageBits = [];
  state.lastRecoveredBits = [];
  state.history = [];

  $("fileName").textContent = "wavelab-demo.wav · generated test signal";
  $("audioInfo").textContent = "44,100 Hz · mono demo signal";
  $("durationInfo").textContent = "Duration: 8.00 s";

  clearResults();
  drawWaveCanvas($("inputWave"), state.original);
  drawWaveCanvas($("outputWave"), null);
  refreshCharts();
  resetBerChart();
  updateButtons();

  setProgress(100, "Demo signal loaded.");
  log("Generated synthetic multitone demo signal.", "ok");
}

/* -------------------------------------------------------
   Bit conversion
------------------------------------------------------- */

function textToBits(text) {
  const bytes = new TextEncoder().encode(text);
  const bits = [];

  for (const byte of bytes) {
    for (let bit = 7; bit >= 0; bit--) {
      bits.push((byte >> bit) & 1);
    }
  }

  return bits;
}

function bitsToText(bits) {
  const bytes = [];

  for (let i = 0; i + 7 < bits.length; i += 8) {
    let byte = 0;
    for (let j = 0; j < 8; j++) {
      byte = (byte << 1) | (bits[i + j] & 1);
    }
    bytes.push(byte);
  }

  try {
    return new TextDecoder("utf-8", { fatal: false }).decode(new Uint8Array(bytes))
      .replace(/\u0000+$/g, "");
  } catch {
    return "";
  }
}

function expandBits(bits, repetitions) {
  const result = [];
  for (const bit of bits) {
    for (let r = 0; r < repetitions; r++) result.push(bit);
  }
  return result;
}

function majorityDecode(bits, repetitions) {
  const decoded = [];

  for (let i = 0; i < bits.length; i += repetitions) {
    const group = bits.slice(i, i + repetitions);
    const ones = group.reduce((sum, bit) => sum + bit, 0);
    decoded.push(ones > group.length / 2 ? 1 : 0);
  }

  return decoded;
}

/* -------------------------------------------------------
   DSP utilities
------------------------------------------------------- */

function nextPowerOfTwo(n) {
  let p = 1;
  while (p < n) p *= 2;
  return p;
}

function fft(realInput) {
  const n = nextPowerOfTwo(realInput.length);
  const re = new Float64Array(n);
  const im = new Float64Array(n);

  for (let i = 0; i < realInput.length; i++) re[i] = realInput[i];

  let j = 0;
  for (let i = 1; i < n; i++) {
    let bit = n >> 1;
    while (j & bit) {
      j ^= bit;
      bit >>= 1;
    }
    j ^= bit;

    if (i < j) {
      [re[i], re[j]] = [re[j], re[i]];
      [im[i], im[j]] = [im[j], im[i]];
    }
  }

  for (let len = 2; len <= n; len <<= 1) {
    const angle = -2 * Math.PI / len;
    const wlenRe = Math.cos(angle);
    const wlenIm = Math.sin(angle);

    for (let i = 0; i < n; i += len) {
      let wRe = 1;
      let wIm = 0;
      const half = len >> 1;

      for (let k = 0; k < half; k++) {
        const uRe = re[i + k];
        const uIm = im[i + k];
        const vRe = re[i + k + half] * wRe - im[i + k + half] * wIm;
        const vIm = re[i + k + half] * wIm + im[i + k + half] * wRe;

        re[i + k] = uRe + vRe;
        im[i + k] = uIm + vIm;
        re[i + k + half] = uRe - vRe;
        im[i + k + half] = uIm - vIm;

        const nextWRe = wRe * wlenRe - wIm * wlenIm;
        wIm = wRe * wlenIm + wIm * wlenRe;
        wRe = nextWRe;
      }
    }
  }

  return { re, im };
}

function ifft(reInput, imInput) {
  const re = Float64Array.from(reInput);
  const im = Float64Array.from(imInput);

  for (let i = 0; i < im.length; i++) im[i] = -im[i];

  const transformed = fftComplex(re, im);

  for (let i = 0; i < transformed.re.length; i++) {
    transformed.re[i] /= transformed.re.length;
    transformed.im[i] = -transformed.im[i] / transformed.re.length;
  }

  return transformed.re;
}

function fftComplex(realInput, imagInput) {
  const n = realInput.length;
  const re = Float64Array.from(realInput);
  const im = Float64Array.from(imagInput);

  let j = 0;
  for (let i = 1; i < n; i++) {
    let bit = n >> 1;
    while (j & bit) {
      j ^= bit;
      bit >>= 1;
    }
    j ^= bit;

    if (i < j) {
      [re[i], re[j]] = [re[j], re[i]];
      [im[i], im[j]] = [im[j], im[i]];
    }
  }

  for (let len = 2; len <= n; len <<= 1) {
    const angle = -2 * Math.PI / len;
    const wlenRe = Math.cos(angle);
    const wlenIm = Math.sin(angle);

    for (let i = 0; i < n; i += len) {
      let wRe = 1;
      let wIm = 0;
      const half = len >> 1;

      for (let k = 0; k < half; k++) {
        const uRe = re[i + k];
        const uIm = im[i + k];
        const vRe = re[i + k + half] * wRe - im[i + k + half] * wIm;
        const vIm = re[i + k + half] * wIm + im[i + k + half] * wRe;

        re[i + k] = uRe + vRe;
        im[i + k] = uIm + vIm;
        re[i + k + half] = uRe - vRe;
        im[i + k + half] = uIm - vIm;

        const nr = wRe * wlenRe - wIm * wlenIm;
        wIm = wRe * wlenIm + wIm * wlenRe;
        wRe = nr;
      }
    }
  }

  return { re, im };
}

function hammingWindow(n) {
  const window = new Float64Array(n);
  for (let i = 0; i < n; i++) {
    window[i] = n <= 1 ? 1 : 0.54 - 0.46 * Math.cos(2 * Math.PI * i / (n - 1));
  }
  return window;
}

function normalizeAudio(samples) {
  let peak = 0;
  for (let i = 0; i < samples.length; i++) {
    peak = Math.max(peak, Math.abs(samples[i]));
  }
  if (!peak) return Float32Array.from(samples);

  const output = new Float32Array(samples.length);
  for (let i = 0; i < samples.length; i++) output[i] = samples[i] / peak * 0.95;
  return output;
}

/* -------------------------------------------------------
   FFT-frame watermark embedding
   Quantization index modulation of selected magnitudes.
------------------------------------------------------- */

function embedWatermark(samples, bits, strength, frameSize, repetitions) {
  const repeated = expandBits(bits, repetitions);
  const hop = frameSize;
  const frameCount = Math.floor(samples.length / hop);

  if (frameCount < repeated.length) {
    throw new Error(
      "Payload is too long. Use a shorter message, lower repetition, " +
      "or longer audio."
    );
  }

  const output = Float32Array.from(samples);
  const positions = [];

  // Restrict watermark frequencies to 500–3000 Hz.
  const minBin = Math.max(2, Math.ceil(500 * frameSize / state.sampleRate));
  const maxBin = Math.min(
    Math.floor(frameSize / 2) - 1,
    Math.floor(3000 * frameSize / state.sampleRate)
  );

  const usableBins = maxBin - minBin + 1;

  if (usableBins < 4) {
    throw new Error("Selected FFT size is too small for the watermark band.");
  }

  for (let k = 0; k < repeated.length; k++) {
    const frameIndex = Math.floor(k * frameCount / repeated.length);
    const start = frameIndex * hop;

    const frame = new Float64Array(frameSize);
    let power = 0;

    for (let i = 0; i < frameSize; i++) {
      frame[i] = samples[start + i] || 0;
      power += frame[i] * frame[i];
    }

    const frameRms = Math.sqrt(power / frameSize);
    const spectrum = fft(frame);

    const bin = minBin + ((k * 37 + 11) % usableBins);
    const mirrorBin = frameSize - bin;

    const real = spectrum.re[bin];
    const imag = spectrum.im[bin];

    const mag = Math.hypot(real, imag);
    const phase = Math.atan2(imag, real);

    // Adaptive quantization step.
    const q = Math.max(
      1e-7,
      strength * Math.max(mag, frameRms * frameSize * 0.25)
    );

    let index = Math.round(mag / q);

    // Force the quantization index to represent the required bit.
    if ((index & 1) !== repeated[k]) {
      const lower = Math.max(0, index - 1);
      const upper = index + 1;

      const lowerDistance = Math.abs(mag - lower * q);
      const upperDistance = Math.abs(mag - upper * q);

      index = lowerDistance <= upperDistance ? lower : upper;
    }

    const newMag = index * q;

    // Preserve the original phase.
    const newReal = newMag * Math.cos(phase);
    const newImag = newMag * Math.sin(phase);

    // Modify the positive-frequency component.
    spectrum.re[bin] = newReal;
    spectrum.im[bin] = newImag;

    // Modify its conjugate to maintain a real-valued signal.
    spectrum.re[mirrorBin] = newReal;
    spectrum.im[mirrorBin] = -newImag;

    const reconstructed = ifft(spectrum.re, spectrum.im);

    for (let i = 0; i < frameSize; i++) {
      output[start + i] += reconstructed[i] - frame[i];
    }

    positions.push({
      frameIndex,
      bin,
      q
    });
  }

  return {
    samples: output,
    positions,
    repeatedBits: repeated
  };
}
function extractWatermark(
  samples,
  bitCount,
  frameSize,
  repetitions,
  positions
) {
  if (!positions || positions.length === 0) {
    throw new Error("Embed a watermark before attempting extraction.");
  }

  const extractedRepeated = [];

  for (let k = 0; k < positions.length; k++) {
    const { frameIndex, bin, q } = positions[k];
    const start = frameIndex * frameSize;

    if (start + frameSize > samples.length) {
      throw new Error("Audio is too short for the selected watermark frame.");
    }

    // Use exactly the same rectangular-window processing as embedding.
    const frame = new Float64Array(frameSize);

    for (let i = 0; i < frameSize; i++) {
      frame[i] = samples[start + i];
    }

    const spectrum = fft(frame);

    const mag = Math.hypot(
      spectrum.re[bin],
      spectrum.im[bin]
    );

    const index = Math.round(mag / q);

    extractedRepeated.push(index & 1);
  }

  const decoded = majorityDecode(extractedRepeated, repetitions);

  return decoded.slice(0, bitCount);
}

/* -------------------------------------------------------
   Attack simulations
------------------------------------------------------- */

function seededRandomGenerator(seed) {
  let value = seed >>> 0;
  return function () {
    value = (1664525 * value + 1013904223) >>> 0;
    return value / 4294967296;
  };
}

function gaussianRandom(random) {
  const u = Math.max(1e-12, random());
  const v = Math.max(1e-12, random());
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
}

function addNoise(samples, snrDb) {
  let signalPower = 0;
  for (const sample of samples) signalPower += sample * sample;
  signalPower /= Math.max(1, samples.length);

  const noisePower = signalPower / Math.pow(10, snrDb / 10);
  const std = Math.sqrt(noisePower);
  const random = seededRandomGenerator(20261024);

  const output = new Float32Array(samples.length);
  for (let i = 0; i < samples.length; i++) {
    output[i] = samples[i] + gaussianRandom(random) * std;
  }
  return output;
}

function lowPassFilter(samples, sampleRate, cutoff) {
  // A simple one-pole low-pass filter, implemented in both directions
  // to reduce phase distortion.
  const alpha = 1 - Math.exp(-2 * Math.PI * cutoff / sampleRate);

  function filter(input) {
    const output = new Float32Array(input.length);
    let previous = 0;

    for (let i = 0; i < input.length; i++) {
      previous += alpha * (input[i] - previous);
      output[i] = previous;
    }
    return output;
  }

  const forward = filter(samples);
  const reversed = Float32Array.from(forward).reverse();
  return Float32Array.from(filter(reversed).reverse());
}

function resampleAudio(samples, factor) {
  const newLength = Math.max(1, Math.round(samples.length * factor));
  const output = new Float32Array(newLength);

  for (let i = 0; i < newLength; i++) {
    const sourcePosition = i / factor;
    const left = Math.floor(sourcePosition);
    const right = Math.min(samples.length - 1, left + 1);
    const fraction = sourcePosition - left;

    output[i] =
      (samples[left] || 0) * (1 - fraction) +
      (samples[right] || 0) * fraction;
  }

  return output;
}

/* -------------------------------------------------------
   Metrics
------------------------------------------------------- */

function calculateBer(originalBits, recoveredBits) {
  if (!originalBits.length) return NaN;

  let errors = 0;
  for (let i = 0; i < originalBits.length; i++) {
    if (originalBits[i] !== recoveredBits[i]) errors++;
  }

  return { errors, ber: errors / originalBits.length };
}

function calculateSignalMetrics(reference, test) {
  const length = Math.min(reference.length, test.length);
  if (!length) return { snr: NaN, psnr: NaN, mse: NaN };

  let signalPower = 0;
  let noisePower = 0;
  let squaredError = 0;
  let peak = 0;

  for (let i = 0; i < length; i++) {
    const a = reference[i];
    const b = test[i];
    const error = a - b;

    signalPower += a * a;
    noisePower += error * error;
    squaredError += error * error;
    peak = Math.max(peak, Math.abs(a));
  }

  signalPower /= length;
  noisePower /= length;
  const mse = squaredError / length;

  const snr = noisePower === 0
    ? Infinity
    : 10 * Math.log10(signalPower / noisePower);

  const psnr = mse === 0
    ? Infinity
    : 20 * Math.log10(Math.max(peak, 1e-12) / Math.sqrt(mse));

  return { snr, psnr, mse };
}

function formatMetric(value, suffix = "") {
  if (!Number.isFinite(value)) return value === Infinity ? "∞" : "—";
  return value.toFixed(2) + suffix;
}

function updateMetricCards(ber, metrics, bitCount) {
  $("metricBer").textContent = Number.isFinite(ber)
    ? (ber * 100).toFixed(2) + "%"
    : "—";
  $("metricSnr").textContent = formatMetric(metrics.snr, " dB");
  $("metricPsnr").textContent = formatMetric(metrics.psnr, " dB");
  $("metricBits").textContent = bitCount ? bitCount : "—";
}

