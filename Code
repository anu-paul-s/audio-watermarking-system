$("downloadBtn").addEventListener("click", downloadProcessed);

$("playOriginalBtn").addEventListener("click", () => {
  playSamples(state.original, state.sampleRate, "original");
});

$("pauseOriginalBtn").addEventListener("click", () => {
  pauseSamples("original");
});

$("playOutputBtn").addEventListener("click", () => {
  playSamples(state.processed, state.processedSampleRate || state.sampleRate, "processed");
});

$("pauseOutputBtn").addEventListener("click", () => {
  pauseSamples("processed");
});

$("attackType").addEventListener("change", updateAttackFields);
$("strength").addEventListener("input", updateSliderLabels);
$("noiseLevel").addEventListener("input", updateSliderLabels);
$("cutoff").addEventListener("input", updateSliderLabels);

$("clearLogBtn").addEventListener("click", () => {
  $("log").innerHTML = "";
  log("Log cleared.");
});

window.addEventListener("resize", () => {
  if (state.original) {
    drawWaveCanvas($("inputWave"), state.original);
  }
  drawWaveCanvas($("outputWave"), state.processed);
});

function initialize() {
  updateAttackFields();
  updateSliderLabels();
  drawWaveCanvas($("inputWave"), null);
  drawWaveCanvas($("outputWave"), null);
  refreshCharts();
  resetBerChart();
  updateButtons();
  log("WaveLab initialized. Ready for audio input.", "ok");
}

initialize();
</script>
</body>
</html>
