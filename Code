async function embedAction() {
  if (!state.original || state.busy) return;
  stopAllPlayers();

  try {
    setBusy(true);
    setProgress(5, "Preparing watermark payload...");
    await new Promise(resolve => setTimeout(resolve, 20));

    const message = $("watermarkText").value.trim();
    if (!message) throw new Error("Enter a watermark message first.");

    const bits = textToBits(message);
    const strength = Number($("strength").value);
    const frameSize = Number($("fftSize").value);
    const repetitions = Number($("repeatBits").value);

    state.messageBits = bits;
    $("originalMessage").textContent = message;
    $("recoveredMessage").textContent = "Awaiting extraction";

    setProgress(25, "Embedding bits in frequency-domain frames...");
    log("Embedding " + bits.length + " payload bits.");

    await new Promise(resolve => setTimeout(resolve, 20));

    const result = embedWatermark(
      state.original, bits, strength, frameSize, repetitions
    );

    state.embedded = result.samples;
    state.processed = Float32Array.from(result.samples);
    state.processedSampleRate = state.sampleRate;
    state.positions = result.positions;
    state.frameSize = frameSize;
    state.repetitions = repetitions;
    state.embeddingStrength = strength;

    setProgress(75, "Calculating signal quality metrics...");
    const metrics = calculateSignalMetrics(state.original, state.embedded);

    drawWaveCanvas($("outputWave"), state.processed);
    refreshCharts();

    $("metricBits").textContent = bits.length;
    $("metricSnr").textContent = formatMetric(metrics.snr, " dB");
    $("metricPsnr").textContent = formatMetric(metrics.psnr, " dB");
    $("metricBer").textContent = "—";

    $("bitErrors").textContent = "—";
    $("recoveryStatus").textContent = "Not tested";

    state.history = [{
      label: "Embedded",
      ber: null
    }];
    updateBerChart();

    setProgress(100, "Watermark embedded. Run extraction to evaluate recovery.");
    log("Watermark embedded using FFT magnitude quantization.", "ok");
    log("Embedding SNR: " + formatMetric(metrics.snr, " dB") + ".");
    log("Embedding PSNR: " + formatMetric(metrics.psnr, " dB") + ".");

    updateButtons();
  } catch (err) {
    setProgress(0, err.message);
    log(err.message, "error");
    alert(err.message);
  } finally {
    setBusy(false);
  }
}


async function extractAction() {

  // Check whether extraction can proceed
  if (!state.processed) {
    log("Extraction failed: No processed audio available.", "error");
    setProgress(0, "Please embed the watermark first.");
    return;
  }

  if (!state.messageBits || state.messageBits.length === 0) {
    log("Extraction failed: No watermark bits found.", "error");
    setProgress(0, "Please embed a watermark first.");
    return;
  }

  if (state.busy) {
    log("Extraction skipped: Another operation is running.", "warn");
    return;
  }

  try {
    setBusy(true);

    setProgress(20, "Starting watermark extraction...");
    log("Starting extraction...", "info");

    const recovered = extractWatermark(
      state.processed,
      state.messageBits.length,
      state.frameSize,
      state.repetitions,
      state.positions
    );

    log("Watermark bits extracted: " + recovered.length);

    if (!recovered || recovered.length === 0) {
      throw new Error("No watermark bits could be recovered.");
    }

    const result = calculateBer(
      state.messageBits,
      recovered
    );

    const recoveredMessage = bitsToText(recovered);

    const metrics = calculateSignalMetrics(
      state.original,
      state.processed
    );

    // Update recovered message
    $("recoveredMessage").textContent =
      recoveredMessage || "(unreadable payload)";

    // Update bit errors
    $("bitErrors").textContent =
      result.errors + " / " + state.messageBits.length;

    // Update recovery status
    $("recoveryStatus").textContent =
      result.errors === 0 ? "Exact match" : "Partial recovery";

    // Update BER and signal quality
    $("metricBer").textContent =
      (result.ber * 100).toFixed(2) + "%";

    $("metricSnr").textContent =
      formatMetric(metrics.snr, " dB");

    $("metricPsnr").textContent =
      formatMetric(metrics.psnr, " dB");

    // Update BER chart history
    const condition = currentCondition();

    const existingIndex = state.history.findIndex(
      item => item.label === condition
    );

    const item = {
      label: condition,
      ber: result.ber
    };

    if (existingIndex >= 0) {
      state.history[existingIndex] = item;
    } else {
      state.history.push(item);
    }

    updateBerChart();

    setProgress(100, "Extraction complete.");

    log(
      "Extraction complete: " +
      result.errors + " bit errors, BER = " +
      (result.ber * 100).toFixed(2) + "%",
      result.errors === 0 ? "ok" : "warn"
    );

  } catch (err) {

    setProgress(0, "Extraction failed: " + err.message);

    log(
      "Extraction error: " + err.message,
      "error"
    );

    console.error("Watermark extraction error:", err);

  } finally {
    setBusy(false);
  }
}


function currentCondition() {
  const type = $("attackType").value;
  if (type === "noise") return "AWGN";
  if (type === "lowpass") return "Low-pass";
  if (type === "resample") return "Resampling";
  return "Baseline";
}

async function applyAttack() {
  if (!state.embedded || state.busy) return;
  stopAllPlayers();

  try {
    setBusy(true);
    setProgress(15, "Applying selected signal transformation...");
    await new Promise(resolve => setTimeout(resolve, 20));

    const type = $("attackType").value;
    let output;

    if (type === "none") {
      output = Float32Array.from(state.embedded);
      state.processedSampleRate = state.sampleRate;
      log("Restored baseline embedded signal.", "ok");
    } else if (type === "noise") {
      state.processedSampleRate = state.sampleRate;
      const snr = Number($("noiseLevel").value);
      output = addNoise(state.embedded, snr);
      log("Applied additive white Gaussian noise at " + snr + " dB SNR.");
    } else if (type === "lowpass") {
      state.processedSampleRate = state.sampleRate;
      const cutoff = Number($("cutoff").value);
      output = lowPassFilter(state.embedded, state.sampleRate, cutoff);
      log("Applied low-pass filter with cutoff " + cutoff + " Hz.");
    } else if (type === "resample") {
      const factor = Number($("resampleRate").value);
      state.processedSampleRate = Math.max(1, Math.round(state.sampleRate * factor));
      output = resampleAudio(state.embedded, factor);
      log("Resampled audio using factor " + factor + "×.", "warn");
      log("Note: simple resampling may shift the payload frame alignment.", "warn");
    } else {
      throw new Error("Unknown attack type.");
    }

    state.processed = output;
    drawWaveCanvas($("outputWave"), state.processed);
    refreshCharts();

    if (output.length === state.original.length) {
      const metrics = calculateSignalMetrics(state.original, output);
      $("metricSnr").textContent = formatMetric(metrics.snr, " dB");
      $("metricPsnr").textContent = formatMetric(metrics.psnr, " dB");
    } else {
      // Length-changing resampling needs time/rate alignment before sample-wise metrics are meaningful.
      $("metricSnr").textContent = "N/A";
      $("metricPsnr").textContent = "N/A";
      log("SNR/PSNR are shown as N/A because resampling changed the sample count; align sample rates before comparing.", "warn");
    }

    setProgress(100, "Attack applied. Extract the watermark to measure robustness.");
    log("Processed signal length: " + output.length.toLocaleString() + " samples.");
    updateButtons();
  } catch (err) {
    setProgress(0, err.message);
    log("Attack failed: " + err.message, "error");
  } finally {
    setBusy(false);
  }
}

function restoreEmbedded() {
  if (!state.embedded) return;
  stopAllPlayers();

  state.processed = Float32Array.from(state.embedded);
  state.processedSampleRate = state.sampleRate;
  drawWaveCanvas($("outputWave"), state.processed);
  refreshCharts();

  $("recoveredMessage").textContent = "Awaiting extraction";
  $("bitErrors").textContent = "—";
  $("recoveryStatus").textContent = "Not tested";
  $("metricBer").textContent = "—";

  setProgress(100, "Restored the embedded signal. Extract to calculate BER.");
  log("Restored embedded audio before attack.", "ok");
  updateButtons();
}

